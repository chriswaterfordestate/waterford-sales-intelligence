# Waterford Sales Intelligence — Environment Variables
# Copy to .env for local development. Never commit .env to source control.
# In production: set these in the Render dashboard Environment Variables section.

# ── Database ──────────────────────────────────────────────────────────────────
# Render provides this automatically from the waterford-si-db service.
# For local development: use your local PostgreSQL connection string.
DATABASE_URL_SYNC=host=localhost dbname=waterford_si user=waterford password=<your_local_password>

# ── Clerk Authentication ───────────────────────────────────────────────────────
# Obtain from: https://dashboard.clerk.com → Your App → API Keys
# SECRET: never put in frontend or commit to git
CLERK_SECRET_KEY=sk_live_...
# PUBLISHABLE: safe to expose in frontend (starts with pk_)
CLERK_PUBLISHABLE_KEY=pk_live_...
# JWKS URL: Clerk → Configure → Sessions → Copy JWKS Endpoint
CLERK_JWKS_URL=https://your-app-id.clerk.accounts.dev/.well-known/jwks.json

# ── Clerk session-token customization (REQUIRED — see admin guide) ─────────────
# In the Clerk dashboard → Configure → Sessions → Customize session token,
# add this JSON so the backend receives the user's role in every JWT:
#
#   { "role": "{{user.public_metadata.role}}" }
#
# Without this step, all users default to REP and cannot access admin/manager endpoints.
# Per-user role is then set via: Clerk dashboard → Users → select user → Public Metadata:
#   { "role": "ADMIN" }    ← for Chris (National Sales Manager)
#   { "role": "MANAGER" }  ← for regional managers
#   { "role": "REP" }      ← for sales reps (default if unset)

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
# Generated by Render automatically (generateValue: true in render.yaml)
APP_SECRET_KEY=<long_random_secret>
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your frontend URL after deployment. Comma-separated for multiple origins.
# Example: https://waterford-si-frontend.onrender.com
# Or after custom domain: https://sales.waterfordestate.co.za
ALLOWED_ORIGINS=https://waterford-si-frontend.onrender.com

# ── Frontend (Vite build-time env vars) ──────────────────────────────────────
# Set in Render frontend service environment variables.
# VITE_ prefix is required — Vite only exposes variables with this prefix.
VITE_API_BASE_URL=https://waterford-si-api.onrender.com
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# ── Redis/Celery (NOT required for current Sprint 5 functionality) ─────────────
# Uncomment if background import processing is added in a future sprint.
# REDIS_URL=redis://...
# CELERY_BROKER_URL=redis://...
# CELERY_RESULT_BACKEND=redis://...

# ── AWS S3 (NOT required — imports use server /tmp storage) ────────────────────
# Uncomment if permanent file storage is needed in a future sprint.
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=waterford-si-imports
# AWS_S3_REGION=af-south-1
