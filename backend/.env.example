# Database
DATABASE_URL=postgresql+asyncpg://waterford:waterford_dev@localhost:5432/waterford_si
DATABASE_URL_TEST=postgresql+asyncpg://waterford:waterford_dev@localhost:5433/waterford_si_test

# Clerk authentication
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_JWKS_URL=https://YOUR_CLERK_DOMAIN/.well-known/jwks.json

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# File storage (S3-compatible)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=waterford-si-imports
AWS_S3_REGION=af-south-1

# App
APP_ENV=development
APP_SECRET_KEY=change_this_in_production
ALLOWED_ORIGINS=http://localhost:5173
